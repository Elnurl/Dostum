{
  "expo": {
    "name": "dostum",
    "slug": "dostum",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "dostum",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "az.dostum.app",
      "infoPlist": {
        "NSCameraUsageDescription": "Profil, heyvan və qayğı hesabatı üçün kamera lazımdır.",
        "NSPhotoLibraryUsageDescription": "Fotoqalereyadan şəkil seçmək üçün icazə lazımdır.",
        "NSLocationWhenInUseUsageDescription": "İt gəzintisinin canlı marşrutunu göstərmək üçün məkan lazımdır."
      }
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#F4F4F8",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "package": "az.dostum.app",
      "permissions": [
        "CAMERA",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "POST_NOTIFICATIONS"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/logo.png"
    },
    "plugins": [
      "expo-router",
      "expo-image",
      [
        "expo-splash-screen",
        {
          "image": "./assets/images/paw-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#FFFFFF"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Fotoqalereyadan şəkil seçmək üçün icazə lazımdır.",
          "cameraPermission": "Profil, heyvan və qayğı hesabatı üçün kamera lazımdır."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "İt gəzintisinin canlı marşrutunu göstərmək üçün məkan lazımdır."
        }
      ],
      "expo-notifications"
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
